# ── Frontend API URL ──────────────────────────────────────────────────────────
#
# Development: Vite proxies /api → http://localhost:5000, so this variable is
# only active when serving the production build (npm run preview).
#
VITE_API_URL=http://localhost:5000/api/v1
#
# Production (Vercel): set this in the Vercel dashboard under
# Project → Settings → Environment Variables.
# Example:
# VITE_API_URL=https://maison-sac-backend.vercel.app/api/v1
